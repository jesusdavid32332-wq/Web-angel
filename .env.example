# Configuración del Servidor y Seguridad Administrativa (Personalizados Ángel)
PORT=3000

# Clave secreta para firmar sesiones JWT del panel /admin (mínimo 32 caracteres recomendados en producción)
JWT_SECRET=

# Opcional: Credenciales iniciales preconfiguradas (si no se definen, /admin mostrará el asistente seguro de creación de propietario en el primer ingreso)
ADMIN_INITIAL_USER=
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Opcional: Código de seguridad requerido durante el registro inicial en /admin
ADMIN_SETUP_TOKEN=
